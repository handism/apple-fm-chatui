{
  "name": "apple-fm-chatui",
  "displayName": "Local FM Chat",
  "description": "MacのApple Foundation Modelsと、VS Codeのサイドバーでローカルチャット。",
  "version": "0.6.0",
  "publisher": "local-fm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/handism/apple-fm-chatui.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Machine Learning"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "localFM.open",
        "title": "Local FM: チャットを開く"
      },
      {
        "command": "localFM.attachSelection",
        "title": "Local FM: 選択テキストをチャットに添付"
      },
      {
        "command": "localFM.attachImageFile",
        "title": "Local FM: 画像をチャットに添付"
      },
      {
        "command": "localFM.selection.summarize",
        "title": "Local FM: 選択テキストを要約",
        "enablement": "editorHasSelection && resourceScheme != local-fm-preview"
      },
      {
        "command": "localFM.selection.rewrite",
        "title": "Local FM: 選択テキストを読みやすくする",
        "enablement": "editorHasSelection && resourceScheme != local-fm-preview"
      },
      {
        "command": "localFM.selection.translate",
        "title": "Local FM: 選択テキストを英訳",
        "enablement": "editorHasSelection && resourceScheme != local-fm-preview"
      },
      {
        "command": "localFM.selection.bullets",
        "title": "Local FM: 選択テキストを箇条書きにする",
        "enablement": "editorHasSelection && resourceScheme != local-fm-preview"
      },
      {
        "command": "localFM.generateCommitMessage",
        "title": "Local FM: コミットメッセージを生成",
        "icon": "$(wand)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "localFM",
          "title": "Local FM",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "localFM": [
        {
          "type": "webview",
          "id": "localFM.chat",
          "name": "Local FM Chat",
          "icon": "media/icon.svg"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "localFM.attachSelection",
          "when": "editorHasSelection",
          "group": "9_cutcopypaste"
        },
        {
          "command": "localFM.selection.summarize",
          "when": "editorHasSelection && resourceScheme != local-fm-preview",
          "group": "localFM@1"
        },
        {
          "command": "localFM.selection.rewrite",
          "when": "editorHasSelection && resourceScheme != local-fm-preview",
          "group": "localFM@2"
        },
        {
          "command": "localFM.selection.translate",
          "when": "editorHasSelection && resourceScheme != local-fm-preview",
          "group": "localFM@3"
        },
        {
          "command": "localFM.selection.bullets",
          "when": "editorHasSelection && resourceScheme != local-fm-preview",
          "group": "localFM@4"
        }
      ],
      "explorer/context": [
        {
          "command": "localFM.attachImageFile",
          "when": "!explorerResourceIsFolder && resourceExtname =~ /^\\.(png|jpe?g)$/i",
          "group": "localFM@1"
        }
      ],
      "scm/title": [
        {
          "command": "localFM.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Local FM",
      "properties": {
        "localFM.commitMessage.language": {
          "type": "string",
          "enum": [
            "en",
            "ja"
          ],
          "enumDescriptions": [
            "英語",
            "日本語"
          ],
          "default": "en",
          "description": "生成するコミットメッセージの件名と本文の言語。type（feat、fixなど）は常に英語です。"
        },
        "localFM.compare.enabled": {
          "type": "boolean",
          "default": false,
          "description": "比較モード。チャットの送信ごとにLocal FMとOllamaの両方に回答させ、並べて表示します。会話の履歴はモデルごとに別々に保持します。選択テキストの処理とコミットメッセージ生成はLocal FMのみです。"
        },
        "localFM.ollama.model": {
          "type": "string",
          "default": "",
          "description": "比較モードで使うOllamaのモデル名（例: gemma4:26b-a4b-it-qat）。空欄の場合はインストール済みの最初のモデルを使います。"
        },
        "localFM.ollama.endpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "scope": "application",
          "description": "OllamaサーバーのURL。会話の内容はこのURLに送信されます。"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "build:native": "node scripts/build-native.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.cjs",
    "package": "npm run build:native && npm run build && vsce package --target darwin-arm64",
    "vscode:prepublish": "npm run build",
    "test:host": "npm run build && node scripts/test-host.cjs"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.9.2",
    "typescript": "5.9.3"
  }
}
